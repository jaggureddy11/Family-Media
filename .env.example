# Database (PostgreSQL via Neon, Supabase, or local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kutumbam?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Admin Access Allowlist (comma-separated)
ADMIN_EMAIL_ALLOWLIST="admin@kutumbam.family"

# Object Storage (Cloudflare R2, Backblaze B2, AWS S3, or MinIO)
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="your-r2-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-r2-secret-access-key"
STORAGE_BUCKET_NAME="kutumbam-media"
STORAGE_REGION="auto"
STORAGE_PUBLIC_URL=""

# Family Help Contact (shown in full-screen Help card)
NEXT_PUBLIC_HELP_CONTACT_NAME="Praneeth"
NEXT_PUBLIC_HELP_PHONE_NUMBER="+919876543210"
NEXT_PUBLIC_HELP_WHATSAPP_NUMBER="+919876543210"

# Media Worker
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=3000
