# Database (PostgreSQL via Neon Serverless)
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@<NEON_HOST>/neondb?sslmode=require"

# Admin Authentication
# Development only: plain text passphrase
ADMIN_PASSPHRASE="your-super-secret-family-admin-passphrase"
# Production (Required): bcrypt hash generated via `npm run hash-passphrase`
ADMIN_PASSPHRASE_HASH=""

# Session Secret for Edge Middleware HMAC Verification (generate 32+ random chars)
SESSION_SECRET="generate-a-random-32-char-string-for-session-signing"

# Object Storage (Backblaze B2 or Cloudflare R2 - S3 Compatible)
# NOTE: Keep "Public access" OFF on the bucket. All media uses short-lived signed URLs.

# Option 1: Backblaze B2 (S3 Compatible)
STORAGE_ENDPOINT="https://s3.<YOUR_REGION>.backblazeb2.com"
STORAGE_REGION="<YOUR_REGION>"
STORAGE_ACCESS_KEY_ID="<YOUR_KEY_ID>"
STORAGE_SECRET_ACCESS_KEY="<YOUR_APPLICATION_KEY>"
STORAGE_BUCKET_NAME="<YOUR_BUCKET_NAME>"
STORAGE_FORCE_PATH_STYLE="true"

# Option 2: Cloudflare R2
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="kutumbam-private"
# R2_ENDPOINT=""

# Family Help Contact (Mom's 1-tap support)
NEXT_PUBLIC_HELP_CONTACT_NAME="Jaggu"
NEXT_PUBLIC_HELP_PHONE_NUMBER="+919876543210"
NEXT_PUBLIC_HELP_WHATSAPP_NUMBER="+919876543210"

# Testing & Staging Helpers (non-production only)
TEST_MODE="false"
