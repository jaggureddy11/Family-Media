datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  FAMILY
}

enum MediaType {
  MOVIE
  PHOTO
  FAMILY_VIDEO
  FILE
}

enum MediaStatus {
  READY
  PROCESSING
  FAILED
}

model User {
  id            String          @id @default(cuid())
  email         String?         @unique
  name_en       String
  name_te       String
  role          Role            @default(FAMILY)
  avatarKey     String?
  pinHash       String?         // Optional 4-digit PIN for shared profiles, default null
  textSize      String          @default("EXTRA_LARGE") // LARGE, EXTRA_LARGE, HUGE
  highContrast  Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  devices       Device[]
  invites       DeviceLink[]    @relation("TargetUser")
  favorites     Favorite[]
  watchProgress WatchProgress[]

  @@index([role])
}

model Device {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String    // e.g. "Amma's Phone", "Living Room TV"
  tokenHash    String    @unique // SHA-256 hash of revocable 12-month session token
  lastSeenAt   DateTime  @default(now())
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean   @default(false)
  expiresAt    DateTime  // 12 months from redemption
  createdAt    DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId, isRevoked])
}

model DeviceLink {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation("TargetUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique // Single-use 24-hour token (SHA-256)
  createdByAdminId  String?
  expiresAt         DateTime  // 24 hours from creation
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model MediaItem {
  id                 String       @id @default(cuid())
  type               MediaType
  status             MediaStatus  @default(READY)
  failureReason      String?
  title_en           String
  title_te           String
  year               Int?
  durationSeconds    Float?
  takenAt            DateTime?
  sizeBytes          BigInt
  checksumSha256     String
  mimeType           String

  originalKey        String       @unique // originals/{type}/{yyyy}/{mediaId}/{filename}
  posterKey          String?      // posters/{mediaId}.jpg (extracted in admin browser)
  thumbKey           String?      // thumbs/{mediaId}.webp (resized in admin browser)
  subtitleKey        String?      // subtitles/{mediaId}.vtt (sidecar WebVTT)
  metadataJson       Json?

  folderPath         String?      @default("/")

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  albumItems         AlbumItem[]
  favorites          Favorite[]
  watchProgress      WatchProgress[]

  @@index([type, status])
  @@index([takenAt])
  @@index([checksumSha256])
  @@index([folderPath])
}

model Album {
  id           String      @id @default(cuid())
  title_en     String
  title_te     String
  coverKey     String?
  isAutoYearly Boolean     @default(false)
  year         Int?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items        AlbumItem[]

  @@index([year])
}

model AlbumItem {
  id          String    @id @default(cuid())
  albumId     String
  album       Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)
  addedAt     DateTime  @default(now())

  @@unique([albumId, mediaItemId])
  @@index([albumId, sortOrder])
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, mediaItemId])
  @@index([userId])
}

model WatchProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItemId     String
  mediaItem       MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  positionSeconds Float     @default(0)
  durationSeconds Float     @default(0)
  isCompleted     Boolean   @default(false)
  lastWatchedAt   DateTime  @default(now())

  @@unique([userId, mediaItemId])
  @@index([userId, lastWatchedAt])
}

model SystemSetting {
  key         String    @id
  value       String
  updatedAt   DateTime  @updatedAt
}
